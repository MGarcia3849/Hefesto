{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Edit(./.hefesto/state.json)",
      "Edit(./.hefesto/trust.json)",
      "Write(./.hefesto/state.json)",
      "Write(./.hefesto/trust.json)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "hefesto status" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "hefesto hook pre-tool-use" }
        ]
      }
    ]
  }
}
