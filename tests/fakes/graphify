"""graphify falso para tests: imita `extract`, `update` y `query` (salida real de graphify 0.9.13).

Cada llamada se registra en `HEFESTO_FAKE_LOG` con argv, cwd, el `git rev-parse HEAD` del cwd en ese momento,
el valor de `GRAPHIFY_QUERY_LOG_DISABLE` y las variables `*_API_KEY` visibles. `install`, `hook` y cualquier
otro subcomando se registran y fallan con 1.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def head() -> str:
    try:
        return subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    except OSError:
        return ""


def main() -> int:
    argv = sys.argv[1:]
    log = os.environ.get("HEFESTO_FAKE_LOG")
    if log:
        record = {"name": "graphify", "argv": argv, "cwd": os.getcwd(), "head": head(), "t": time.time(),
                  "query_log_disabled": os.environ.get("GRAPHIFY_QUERY_LOG_DISABLE"),
                  "api_keys": sorted(k for k in os.environ if k.upper().endswith("_API_KEY"))}
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    if argv and argv[0] == "--version":
        print("graphify 0.9.13")
        return 0
    if not argv or argv[0] not in ("extract", "update", "query"):
        print("subcomando no permitido en el fake", file=sys.stderr)
        return 1
    out = Path(os.getcwd()) / "graphify-out"
    if argv[0] in ("extract", "update"):
        out.mkdir(exist_ok=True)
        (out / "graph.json").write_text(json.dumps({"nodes": 3, "edges": 3}), encoding="utf-8")
        print(f"[graphify {argv[0]}] wrote {out / 'graph.json'}: 3 nodes, 3 edges, 1 communities")
        return 0
    if not (out / "graph.json").exists():
        print("no graph.json found", file=sys.stderr)
        return 1
    sys.stdout.reconfigure(encoding="utf-8")  # type: ignore[union-attr]
    print("Traversal: BFS depth=2 | Start: ['suma()'] | 3 nodes found\n")
    print("NODE suma() [src=src/suma.py loc=L1 community=0]")
    print("EDGE suma() --calls [EXTRACTED context=call]--> doble()")
    return 0


sys.exit(main())
